# Production settings for docker-compose.prod.yml. Copy to .env.production on the server, fill in every
# CHANGE_ME, and never commit it. Generate secrets with:
#   openssl rand -hex 32          (hex: safe inside URLs, used for the database password)
#   openssl rand -base64 32       (CREDENTIALS_ENCRYPTION_KEY must be exactly this: 32 random bytes, base64)

# Public host name (DNS A/AAAA record pointing at this server). Caddy gets the HTTPS certificate for it.
DOMAIN=ai.example.com

# ---------- PostgreSQL (internal to the stack) ----------
POSTGRES_USER=myownai
POSTGRES_PASSWORD=CHANGE_ME_HEX_ONLY
POSTGRES_DB=myownai

# ---------- Secrets ----------
# Backend <-> AI service shared secret (at least 32 characters)
AI_SERVICE_TOKEN=CHANGE_ME
# Encrypts WhatsApp credentials at rest. BACK IT UP: losing it makes stored credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
# Signs access tokens (at least 32 characters)
JWT_ACCESS_SECRET=CHANGE_ME

# First admin, created by the seed command only when the database has no users (password min 12 chars)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- AI ----------
# Checkpoint to load at startup, relative to the checkpoints volume (empty = start without a model;
# activating a version in the dashboard loads it, and the backend reloads the active version after restarts)
AI_MODEL_CHECKPOINT=
AI_MIN_CONFIDENCE=0.5
AI_REQUEST_TIMEOUT_MS=15000
AI_TORCH_THREADS=

# ---------- WhatsApp ----------
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SENDER_INTERVAL_MS=2000

# ---------- Misc ----------
TRAINING_POLL_INTERVAL_MS=3000
# Swagger UI at /api/docs (keep false on a public server)
SWAGGER_ENABLED=false
