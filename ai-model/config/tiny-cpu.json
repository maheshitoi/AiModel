{
  "name": "tiny-cpu",
  "description": "Starter GPT for a 2-core laptop CPU without CUDA (~1.3M parameters). See docs/hardware-and-model-sizing.md.",
  "seed": 1337,
  "dataset": {
    "synthetic_conversations": 10000,
    "business_facts": "config/business.json",
    "validation_split": 0.1,
    "max_turn_chars": 500,
    "mask_customer_pii": true
  },
  "tokenizer": {
    "type": "byte-level-bpe",
    "vocab_size": 4096
  },
  "model": {
    "context_length": 128,
    "n_embd": 128,
    "n_head": 4,
    "n_layer": 4,
    "dropout": 0.1,
    "tie_embeddings": true
  },
  "training": {
    "batch_size": 16,
    "learning_rate": 0.001,
    "min_learning_rate": 0.0001,
    "warmup_steps": 200,
    "max_steps": 5000,
    "weight_decay": 0.1,
    "grad_clip": 1,
    "loss_on": "assistant",
    "log_interval": 50,
    "eval_interval": 250,
    "eval_batches": 20,
    "early_stop_patience": 6,
    "checkpoint_interval": 500,
    "device": "auto",
    "num_threads": 4
  }
}
