# Copy to .env and fill in real values. Never commit .env.

# ---------- Shared ----------
NODE_ENV=development

# ---------- PostgreSQL (Prisma) ----------
# Local dev uses PostgreSQL 17 on 5433. These are local-only dev credentials;
# use a dedicated non-superuser role and a strong password in production.
DATABASE_URL=postgresql://postgres:root@localhost:5433/Ai-model?schema=public&sslmode=disable
# Separate database for integration tests (wiped and re-migrated on every test run)
TEST_DATABASE_URL=postgresql://postgres:root@localhost:5433/Ai-model-test?schema=public&sslmode=disable

# ---------- NestJS backend ----------
BACKEND_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
# Shared secret the backend sends to the AI service (X-Internal-Token). At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_SERVICE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# How long the backend waits for one AI reply (ms)
AI_REQUEST_TIMEOUT_MS=15000

# ---------- WhatsApp Cloud API ----------
# Encrypts WhatsApp tokens and secrets in the database: 32 random bytes, base64. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing or changing it makes the stored credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_TO_32_RANDOM_BYTES_BASE64
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v23.0
# How often queued replies are sent (ms); 0 disables sending
WHATSAPP_SENDER_INTERVAL_MS=2000
# How often running training jobs are synced from the AI service (ms); 0 disables it
TRAINING_POLL_INTERVAL_MS=3000

# ---------- Auth ----------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# First admin account, created by `npm run db:seed` only when no users exist (min 12 chars)
SEED_ADMIN_EMAIL=admin@myownai.local
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- Python AI service ----------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
# Directory holding trained checkpoints (relative to repo root)
CHECKPOINT_DIR=ai-model/checkpoints
# Checkpoint loaded at startup, relative to CHECKPOINT_DIR (leave empty to start without a model)
AI_MODEL_CHECKPOINT=tiny-cpu-v1/best.pt
# Uploaded training datasets (one file per dataset) and the training presets (relative to repo root)
DATASET_DIR=ai-model/dataset/uploads
TRAINING_PRESETS_DIR=ai-model/config
# Upload size limit in bytes (the backend also enforces 20 MB)
DATASET_MAX_BYTES=20971520
# Model replies whose least confident token is below this are replaced by the fallback reply
AI_MIN_CONFIDENCE=0.5
# Seconds a request waits for the model before getting 503
AI_QUEUE_TIMEOUT_SECONDS=10
# CPU threads for PyTorch (empty = PyTorch default)
AI_TORCH_THREADS=
